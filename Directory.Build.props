<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- HellForge's version, one line per release: every assembly's, shown in the launcher's and HellForge-Setup's
         corner (AppVersion) with the commit the SDK appends. -->
    <Version>0.1.13-beta</Version>
  </PropertyGroup>
</Project>
